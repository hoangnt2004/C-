#include<bits/stdc++.h>
using namespace std;
int main(){
    int t;
    cin >> t;
    while(t--){
    	long long n;
    	cin >> n;
    	long k = 0;
        while(n%2 == 0){
        	k = 2;
        	n /= 2;
		}
        while(n % 3 == 0){
            k = 3;
            n /= 3;
        }
    	for(int i = 5; i <= sqrt(n); i+= 6){
    		if(n % i == 0){
    			k = i;
    			while(n % i == 0){
    				n /= i;
				}
			}
            if(n %(i+2) == 0){
                k = i+2;
                while(n % (i+2) == 0){
                    n /= (i+2);
                }
            }
		}
		if(n > 1){
			k= n;
		}
		cout << k << endl;
	}
return 0;
}
