#include<bits/stdc++.h>
using namespace std;
#define ll long long 
vector<vector<int>> kq;
void dq(int i , int s, int n, vector<int> x){
    if(s == n){
        kq.push_back(x);
        return;
    }
    for(int k = i;k < n; k++){
        if(s * k > n){
            return ;
        }
        if(n % k ==0){
            x.push_back(k);
            dq(k , s*k, n , x);
            x.pop_back();
        }
    }
}
void pt(int n){
    vector<int> x;
    dq(2, 1, n, x);
}
int main(){
	int t;
	cin >> t;
	while(t--){
		int n;
        cin >> n;
        kq.clear();
        pt(n);
        cout << kq.size()<<endl;
        for(int i = 0; i < kq.size(); i++){
            for(int j = 0; j < kq[i].size(); j++){
                cout << kq[i][j] << " ";
            }
            cout << endl;
        }
	}
return 0;
}
